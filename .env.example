# Okta JIT Portal - Environment Variables
# Copy this file to .env and fill in your values

# Session encryption key (generate a random string)
SESSION_SECRET=your-session-secret-here

# Okta organization URL
OKTA_ORG_URL=https://your-org.okta.com

# Public URL where this portal is hosted
APP_BASE_URL=http://localhost:8080

# Okta OIDC Web Application credentials
OKTA_CLIENT_ID=your-oidc-client-id
OKTA_CLIENT_SECRET=your-oidc-client-secret

# Okta Workflows OAuth Service App (optional - needed for workflow invocation)
OKTA_WORKFLOWS_CLIENT_ID=your-workflows-client-id
OKTA_WORKFLOWS_KEY_ID=your-workflows-key-id
OKTA_WORKFLOWS_PRIVATE_KEY=your-rs256-private-key-pem-or-jwk
OKTA_WORKFLOWS_INVOKE_URL=https://your-org.workflows.okta.com/api/flo/your-flow-id/invoke
