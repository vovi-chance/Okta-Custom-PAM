<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JIT Admin Portal - Profile</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f0f2f5;
      color: #1a1a2e;
    }
    .navbar {
      background: #0052cc;
      color: #fff;
      padding: 16px 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .navbar h1 { font-size: 18px; font-weight: 600; }
    .navbar-right { display: flex; align-items: center; gap: 16px; }
    .navbar a { color: #fff; text-decoration: none; font-size: 14px; opacity: 0.9; }
    .navbar a:hover { opacity: 1; }
    .main {
      max-width: 720px;
      margin: 32px auto;
      padding: 0 16px;
    }
    .card {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
      padding: 32px;
      margin-bottom: 24px;
    }
    .card h2 {
      font-size: 20px;
      margin-bottom: 16px;
    }
    .profile-row {
      display: flex;
      padding: 12px 0;
      border-bottom: 1px solid #f0f0f0;
    }
    .profile-row:last-child { border-bottom: none; }
    .profile-label {
      width: 160px;
      font-weight: 600;
      font-size: 14px;
      color: #555;
      flex-shrink: 0;
    }
    .profile-value {
      font-size: 14px;
      word-break: break-all;
    }
    .group-list {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .group-tag {
      background: #e3f2fd;
      color: #1565c0;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 500;
    }
    .btn {
      display: inline-block;
      padding: 10px 24px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: background 0.2s;
    }
    .btn-secondary { background: #f0f2f5; color: #333; }
    .btn-secondary:hover { background: #e0e2e5; }
  </style>
</head>
<body>
  <nav class="navbar">
    <h1>&#128274; JIT Admin Portal</h1>
    <div class="navbar-right">
      <a href="/dashboard">Dashboard</a>
      <a href="/logout">Sign Out</a>
    </div>
  </nav>

  <div class="main">
    <div class="card">
      <h2>User Profile</h2>

      <div class="profile-row">
        <span class="profile-label">Name</span>
        <span class="profile-value"><%= user.name || user.preferred_username || 'N/A' %></span>
      </div>

      <div class="profile-row">
        <span class="profile-label">Email</span>
        <span class="profile-value"><%= user.email || 'N/A' %></span>
      </div>

      <div class="profile-row">
        <span class="profile-label">Okta User ID</span>
        <span class="profile-value"><%= user.sub || 'N/A' %></span>
      </div>

      <% if (user.preferred_username) { %>
      <div class="profile-row">
        <span class="profile-label">Username</span>
        <span class="profile-value"><%= user.preferred_username %></span>
      </div>
      <% } %>

      <% if (user.locale) { %>
      <div class="profile-row">
        <span class="profile-label">Locale</span>
        <span class="profile-value"><%= user.locale %></span>
      </div>
      <% } %>

      <% if (user.zoneinfo) { %>
      <div class="profile-row">
        <span class="profile-label">Timezone</span>
        <span class="profile-value"><%= user.zoneinfo %></span>
      </div>
      <% } %>
    </div>

    <% if (groups && groups.length > 0) { %>
    <div class="card">
      <h2>Group Memberships</h2>
      <ul class="group-list">
        <% groups.forEach(function(group) { %>
          <li class="group-tag"><%= group %></li>
        <% }); %>
      </ul>
    </div>
    <% } %>

    <div class="card" style="text-align: center;">
      <a href="/dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>
  </div>
</body>
</html>
