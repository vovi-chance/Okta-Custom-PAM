<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JIT Admin Request Portal</title>
  <link rel="stylesheet" href="/css/home.css">
</head>
<body>
  <div class="container">
    <div class="logo">&#128274;</div>
    <h1>JIT Admin Request Portal</h1>
    <span class="badge">NFI Industries</span>
    <p class="subtitle">
      Request temporary privileged administrator access through a secure, audited process.
    </p>
    <% if (isAuthenticated) { %>
      <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
      <a href="/logout" class="btn btn-secondary">Sign Out</a>
    <% } else { %>
      <a href="/dashboard" class="btn btn-primary">Sign In with Okta</a>
    <% } %>
    <div class="info">
      <p>Authenticated via Google Workspace and Okta.</p>
      <p>All requests are logged and audited.</p>
    </div>
  </div>
</body>
</html>
