<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JIT Admin Request - Dashboard</title>
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <nav class="navbar">
    <h1>&#128274; JIT Admin Portal</h1>
    <div class="navbar-right">
      <span class="user-badge"><%= user.name %></span>
      <a href="/profile">Profile</a>
      <a href="/logout">Sign Out</a>
    </div>
  </nav>

  <div class="main">
    <!-- Status alerts -->
    <div id="alert-success" class="alert alert-success"></div>
    <div id="alert-error" class="alert alert-error"></div>

    <!-- Request types info card -->
    <div class="card">
      <h2>Request Types</h2>
      <p class="card-subtitle">Available JIT admin access request types</p>
      <table class="request-types-table">
        <thead>
          <tr>
            <th>Type</th>
            <th>Duration</th>
            <th>Approval</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Standard</strong></td>
            <td><%= durationRanges.standard.min %>-<%= durationRanges.standard.max %> min</td>
            <td>Manager approval</td>
          </tr>
          <tr>
            <td><strong>Emergency</strong></td>
            <td><%= durationRanges.emergency.min %>-<%= durationRanges.emergency.max %> min</td>
            <td>Auto-approved</td>
          </tr>
          <tr>
            <td><strong>Extended</strong></td>
            <td><%= durationRanges.extended.min %>-<%= durationRanges.extended.max %> min</td>
            <td>Manager approval</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Request form -->
    <div class="card">
      <h2>Submit JIT Access Request</h2>
      <p class="card-subtitle">Request temporary privileged admin access</p>

      <form id="jit-form" data-duration-ranges='<%- JSON.stringify(durationRanges) %>'>
        <div class="form-group">
          <label for="requestType">Request Type</label>
          <select id="requestType" name="requestType" required>
            <option value="">-- Select type --</option>
            <option value="standard">Standard</option>
            <option value="emergency">Emergency</option>
            <option value="extended">Extended</option>
          </select>
          <div id="info-standard" class="type-info">
            Standard request: Manager approval required. Duration <%= durationRanges.standard.min %>-<%= durationRanges.standard.max %> minutes.
          </div>
          <div id="info-emergency" class="type-info emergency">
            Emergency request: Auto-approved with incident ticket. Duration <%= durationRanges.emergency.min %>-<%= durationRanges.emergency.max %> minutes.
          </div>
          <div id="info-extended" class="type-info">
            Extended request: Manager approval required. Duration <%= durationRanges.extended.min %>-<%= durationRanges.extended.max %> minutes.
          </div>
        </div>

        <div class="form-group">
          <label for="durationMinutes">Duration (minutes)</label>
          <input type="number" id="durationMinutes" name="durationMinutes" required min="15" max="480" placeholder="30">
          <div id="duration-hint" class="duration-hint"></div>
        </div>

        <div class="form-group ticket-group" id="ticket-group">
          <label for="incidentTicket">Incident Ticket Number</label>
          <p class="hint">Required for emergency requests (e.g., INC-12345)</p>
          <input type="text" id="incidentTicket" name="incidentTicket" placeholder="INC-12345" maxlength="30">
        </div>

        <div class="form-group">
          <label for="businessJustification">Business Justification</label>
          <p class="hint">Minimum 10 characters. Explain why admin access is needed.</p>
          <textarea id="businessJustification" name="businessJustification" required minlength="10" maxlength="1000" placeholder="Describe the reason for requesting admin access..."></textarea>
        </div>

        <button type="submit" id="submit-btn" class="btn btn-primary">
          Submit Request
        </button>
      </form>
    </div>
  </div>

  <script src="/js/dashboard.js" defer></script>
</body>
</html>
