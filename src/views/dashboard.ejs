<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JIT Admin Request - Dashboard</title>
  <link rel="stylesheet" href="/css/common.css?v=<%= cacheBust %>">
  <link rel="stylesheet" href="/css/dashboard.css?v=<%= cacheBust %>">
</head>
<body>
  <nav class="navbar">
    <div class="navbar-inner">
      <h1><span class="tailwind-icon" aria-hidden="true"></span> JIT Admin Portal</h1>
      <div class="navbar-right">
        <span class="user-badge"><%= user.name %></span>
        <a href="/profile">Profile</a>
        <a href="/logout">Sign Out</a>
      </div>
    </div>
  </nav>

  <div class="main">
    <!-- Status alerts -->
    <div id="alert-success" class="alert alert-success"></div>
    <div id="alert-error" class="alert alert-error"></div>

    <!-- Request types info card -->
    <div class="card">
      <h2>Request Types</h2>
      <p class="card-subtitle">Available JIT admin access request types</p>
      <table class="request-types-table">
        <thead>
          <tr>
            <th>Type</th>
            <th>Approval</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Standard</strong></td>
            <td>User approval</td>
          </tr>
          <tr>
            <td><strong>Extended</strong></td>
            <td>User approval</td>
          </tr>
          <tr>
            <td><strong>Emergency</strong></td>
            <td>Manager approval</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Request form -->
    <div class="card">
      <h2>Submit JIT Access Request</h2>
      <p class="card-subtitle">Request temporary privileged admin access</p>

      <form id="jit-form" data-duration-ranges="<%= JSON.stringify(durationRanges) %>">
        <div class="form-group">
          <label for="requestType">Request Type</label>
          <select id="requestType" name="requestType" required>
            <option value="">-- Select type --</option>
            <option value="standard">Standard</option>
            <option value="extended">Extended</option>
            <option value="emergency">Emergency</option>
          </select>
          <div id="info-standard" class="type-info">
            Standard request: User approval required. Duration <%= durationRanges.standard.min %>-<%= durationRanges.standard.max %> minutes.
          </div>
          <div id="info-emergency" class="type-info emergency">
            Emergency request: Manager approval required. Duration <%= durationRanges.emergency.min %>-<%= durationRanges.emergency.max %> minutes.
          </div>
          <div id="info-extended" class="type-info">
            Extended request: User approval required.
          </div>
        </div>

        <div class="form-group">
          <label for="durationMinutes">Duration</label>
          <div class="duration-row">
            <select id="durationUnit">
              <option value="minutes">Minutes</option>
              <option value="hours">Hours</option>
            </select>
            <input type="number" id="durationMinutes" name="durationMinutes" required min="15" max="480" placeholder="15">
          </div>
          <div id="duration-hint" class="duration-hint"></div>
        </div>

        <div class="form-group is-hidden" id="justification-group">
          <label for="businessJustification">Business Justification</label>
          <p class="hint">Minimum 10 characters. Explain why admin access is needed.</p>
          <textarea id="businessJustification" name="businessJustification" minlength="10" maxlength="1000" placeholder="Describe the reason for requesting admin access..."></textarea>
        </div>

        <button type="submit" id="submit-btn" class="btn btn-primary">
          Submit Request
        </button>
      </form>
    </div>
  </div>

  <script src="/js/dashboard.js?v=<%= cacheBust %>"></script>
</body>
</html>
